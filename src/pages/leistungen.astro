---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import "../styles/landing.css";
import { locations, services, servicePath } from "../data/site";

// Leistungs-Hub: acht Gewerke als eigene Themenwelten. Jedes Kapitel hat
// sein eigenes Bühnenbild (Vollbild-Szene, Rhythmusbalken, Sucher-Rahmen,
// Schallringe, Filmstreifen, Projektionsdopplung, Mapping-Raster) und
// verlinkt auf die vollwertige Leistungs-Landingpage.
const chapterOrder = [
  "eventfilm",
  "musikvideo",
  "imagefilm",
  "kamera-bildgestaltung",
  "tonaufnahme",
  "postproduktion",
  "live-visuals",
  "projection-mapping",
];
const chapterMedia: Record<string, string> = {
  eventfilm: "/media/spektra-buehne-03.jpg",
  musikvideo: "/media/spektra-buehne-02.jpg",
  imagefilm: "/media/journal-01.jpg",
  "kamera-bildgestaltung": "/media/spektra-set-hoch.jpg",
  tonaufnahme: "/media/set-hoch-02.jpg",
  postproduktion: "/media/journal-02.jpg",
  "live-visuals": "/media/club-projektion-01.jpg",
  "projection-mapping": "/media/spektra-detail-03.jpg",
};
const chapters = chapterOrder.map((slug) => services.find((service) => service.slug === slug)!);
---

<BaseLayout title="Leistungen | Videografie, Postproduktion, VJ & Mapping" description="Leistungen von Sophia Ramahi: Videografie, Kamera, Ton, Postproduktion, Live Visuals und Projection Mapping in Düsseldorf und NRW.">
  <div data-landing>
    <!-- Hero: bewegtes Licht + Sprung-Index -->
    <section class="lw-hero">
      <div class="lw-hero__media" aria-hidden="true">
        <video muted loop playsinline preload="none" poster="/media/hero-poster.jpg" width="1280" height="720" data-ambient-video>
          <source src="/media/hero-loop.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="cine-wrap lw-hero__grid">
        <div class="lw-hero__content">
          <Breadcrumbs items={[{ label: "Start", href: "/" }, { label: "Leistungen" }]} />
          <p class="ld-hero__kicker">Leistungen · Düsseldorf & NRW</p>
          <h1 class="ld-hero__title">Vom ersten Bild bis zur fertigen <em>Ausspielung</em>.</h1>
          <p class="ld-hero__lead">Acht Gewerke, eine Handschrift: Videografie, Ton, Postproduktion und visuelle Räume — komplette Produktionen oder einzelne Gewerke, sauber abgegrenzt und ehrlich kalkuliert.</p>
          <div class="ld-hero__actions">
            <a class="cine-btn" href="/kontakt/">Projekt anfragen</a>
            <a class="cine-ghost" href="/arbeiten/">Projekte ansehen</a>
          </div>
        </div>
        <nav aria-label="Direkt zu den Leistungen">
          <ol class="lw-index">
            {chapters.map((service, index) => (
              <li>
                <a href={`#${service.slug}`}>
                  <span class="lw-index__num">{String(index + 1).padStart(2, "0")}</span>
                  <span class="lw-index__name">{service.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </section>

    <!-- SEO-Überblick -->
    <section class="cine-wrap ld-split">
      <div class="ld-split__head" data-fx="rise">
        <span class="cine-label">Der Überblick</span>
        <h2>Komplette Produktion oder einzelnes Gewerk</h2>
      </div>
      <div class="ld-split__prose" data-fx="rise">
        <p>Sophia Ramahi produziert in Düsseldorf und ganz NRW: Eventfilme, Musikvideos und Imagefilme, Kamera und Bildgestaltung für Produktionsteams, Tonaufnahme am Set, Postproduktion sowie Live Visuals und Projection Mapping für Bühne und Raum.</p>
        <p>Jedes Gewerk ist einzeln buchbar — mit klaren Zuständigkeiten, transparenter Kalkulation und einem visuellen Konzept, das zum Anlass passt. Wenn ein Projekt mehr braucht, wird das passende Team zusammengestellt statt improvisiert.</p>
      </div>
    </section>

    <!-- 01 Eventfilm: Vollbild-Bühne -->
    <section id="eventfilm" class="lw-chapter lw-chapter--eventfilm">
      <div class="lw-chapter__stagebg" aria-hidden="true">
        <img src={chapterMedia.eventfilm} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
      </div>
      <div class="lw-beam" aria-hidden="true"></div>
      <span class="lw-chapter__ghost" aria-hidden="true">01</span>
      <div class="lw-chapter__inner">
        <div class="lw-chapter__content" data-fx="rise">
          <span class="cine-label">{chapters[0].eyebrow}</span>
          <h2><a href={servicePath(chapters[0])}>{chapters[0].title}</a></h2>
          <p class="lw-chapter__lead">{chapters[0].summary}</p>
          <p>{chapters[0].intro}</p>
          <div class="lw-chapter__links">
            <a class="cine-link" href={servicePath(chapters[0])}><span>Zur Eventfilm-Seite</span><span aria-hidden="true">→</span></a>
          </div>
          <p class="lw-chapter__local">Auch vor Ort: <a href={`${servicePath(chapters[0])}koeln/`}>Köln</a>, <a href={`${servicePath(chapters[0])}essen/`}>Essen</a> und <a href="#einsatzorte">14 weitere Städte</a></p>
        </div>
      </div>
    </section>

    <!-- 02 Musikvideo: violette Bühne + Rhythmus -->
    <section id="musikvideo" class="lw-chapter lw-chapter--musikvideo lw-chapter--flip">
      <div class="lw-chapter__stagebg" aria-hidden="true">
        <img src={chapterMedia.musikvideo} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
      </div>
      <span class="lw-bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
      <span class="lw-chapter__ghost" aria-hidden="true">02</span>
      <div class="lw-chapter__inner">
        <div class="lw-chapter__content" data-fx="rise">
          <span class="cine-label">{chapters[1].eyebrow}</span>
          <h2><a href={servicePath(chapters[1])}>{chapters[1].title}</a></h2>
          <p class="lw-chapter__lead">{chapters[1].summary}</p>
          <p>{chapters[1].intro}</p>
          <div class="lw-chapter__links">
            <a class="cine-link" href={servicePath(chapters[1])}><span>Zur Musikvideo-Seite</span><span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 03 Imagefilm: ruhige Mitte im echten Licht -->
    <section id="imagefilm" class="lw-chapter lw-chapter--imagefilm lw-chapter--center">
      <div class="lw-chapter__stagebg" aria-hidden="true">
        <img src={chapterMedia.imagefilm} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
      </div>
      <div class="lw-glow" aria-hidden="true"></div>
      <span class="lw-chapter__ghost" aria-hidden="true">03</span>
      <div class="lw-chapter__inner">
        <div class="lw-chapter__content" data-fx="rise">
          <span class="cine-label">{chapters[2].eyebrow}</span>
          <h2><a href={servicePath(chapters[2])}>{chapters[2].title}</a></h2>
          <p class="lw-chapter__lead">{chapters[2].summary}</p>
          <p>{chapters[2].intro}</p>
          <div class="lw-chapter__links">
            <a class="cine-link" href={servicePath(chapters[2])}><span>Zur Imagefilm-Seite</span><span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 04 Kamera & Bildgestaltung: der Viewport wird zum Sucher -->
    <section id="kamera-bildgestaltung" class="lw-chapter lw-chapter--kamera-bildgestaltung">
      <div class="lw-chapter__stagebg" aria-hidden="true">
        <img src={chapterMedia["kamera-bildgestaltung"]} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
      </div>
      <span class="lw-finder" aria-hidden="true"><i></i><i></i><i></i><i></i><span class="lw-finder__rec">Rec</span><span class="lw-finder__cross"></span></span>
      <span class="lw-chapter__ghost" aria-hidden="true">04</span>
      <div class="lw-chapter__inner">
        <div class="lw-chapter__content" data-fx="rise">
          <span class="cine-label">{chapters[3].eyebrow}</span>
          <h2><a href={servicePath(chapters[3])}>{chapters[3].title}</a></h2>
          <p class="lw-chapter__lead">{chapters[3].summary}</p>
          <p>{chapters[3].intro}</p>
          <div class="lw-chapter__links">
            <a class="cine-link" href={servicePath(chapters[3])}><span>Zur Kamera-Seite</span><span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 05 Tonaufnahme: Schallringe im Dunkel -->
    <section id="tonaufnahme" class="lw-chapter lw-chapter--tonaufnahme">
      <div class="lw-chapter__stagebg" aria-hidden="true">
        <img src={chapterMedia.tonaufnahme} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
      </div>
      <span class="lw-rings" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="lw-chapter__ghost" aria-hidden="true">05</span>
      <div class="lw-chapter__inner">
        <div class="lw-chapter__content" data-fx="rise">
          <span class="cine-label">{chapters[4].eyebrow}</span>
          <h2><a href={servicePath(chapters[4])}>{chapters[4].title}</a></h2>
          <p class="lw-chapter__lead">{chapters[4].summary}</p>
          <p>{chapters[4].intro}</p>
          <div class="lw-chapter__links">
            <a class="cine-link" href={servicePath(chapters[4])}><span>Zur Tonaufnahme-Seite</span><span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 06 Postproduktion: Schnitt-Timeline über der Szene -->
    <section id="postproduktion" class="lw-chapter lw-chapter--postproduktion">
      <div class="lw-chapter__stagebg" aria-hidden="true">
        <img src={chapterMedia.postproduktion} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
      </div>
      <span class="lw-timeline" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><span class="lw-timeline__head"></span></span>
      <span class="lw-chapter__ghost" aria-hidden="true">06</span>
      <div class="lw-chapter__inner">
        <div class="lw-chapter__content" data-fx="rise">
          <span class="cine-label">{chapters[5].eyebrow}</span>
          <h2><a href={servicePath(chapters[5])}>{chapters[5].title}</a></h2>
          <p class="lw-chapter__lead">{chapters[5].summary}</p>
          <p>{chapters[5].intro}</p>
          <div class="lw-chapter__links">
            <a class="cine-link" href={servicePath(chapters[5])}><span>Zur Postproduktions-Seite</span><span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 07 Live Visuals: Projektionsdopplung -->
    <section id="live-visuals" class="lw-chapter lw-chapter--live-visuals">
      <div class="lw-chapter__stagebg" aria-hidden="true">
        <img src={chapterMedia["live-visuals"]} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
        <img class="lw-echo" src={chapterMedia["live-visuals"]} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
      </div>
      <span class="lw-chapter__ghost" aria-hidden="true">07</span>
      <div class="lw-chapter__inner">
        <div class="lw-chapter__content" data-fx="rise">
          <span class="cine-label">{chapters[6].eyebrow}</span>
          <h2><a href={servicePath(chapters[6])}>{chapters[6].title}</a></h2>
          <p class="lw-chapter__lead">{chapters[6].summary}</p>
          <p>{chapters[6].intro}</p>
          <div class="lw-chapter__links">
            <a class="cine-link" href={servicePath(chapters[6])}><span>Zur Live-Visuals-Seite</span><span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 08 Projection Mapping: das Raster liegt auf der ganzen Fläche -->
    <section id="projection-mapping" class="lw-chapter lw-chapter--projection-mapping lw-chapter--flip">
      <div class="lw-chapter__stagebg" aria-hidden="true">
        <img src={chapterMedia["projection-mapping"]} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
      </div>
      <span class="lw-grid-overlay" aria-hidden="true"></span>
      <span class="lw-chapter__ghost" aria-hidden="true">08</span>
      <div class="lw-chapter__inner">
        <div class="lw-chapter__content" data-fx="rise">
          <span class="cine-label">{chapters[7].eyebrow}</span>
          <h2><a href={servicePath(chapters[7])}>{chapters[7].title}</a></h2>
          <p class="lw-chapter__lead">{chapters[7].summary}</p>
          <p>{chapters[7].intro}</p>
          <div class="lw-chapter__links">
            <a class="cine-link" href={servicePath(chapters[7])}><span>Zur Mapping-Seite</span><span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- Einsatzorte -->
    <section class="ld-places" id="einsatzorte">
      <div class="cine-wrap">
        <div class="ld-places__head" data-fx="rise">
          <span class="cine-label">Einsatzorte</span>
          <h2 class="cine-h2">Jede Leistung — auch bei Ihnen vor Ort</h2>
          <p class="cine-lead">Die Basis ist Düsseldorf. Für jede Stadt gibt es lokale Leistungsseiten mit Logistik, Anfahrt und passenden Referenzen.</p>
        </div>
        <p class="ld-places__list" data-fx="rise">
          {locations.map((city) => (
            <a href={`/standorte/${city.slug}/`}>{city.city}</a>
          ))}
        </p>
        <div class="ld-places__note">
          <p class="u-caption">Keine Niederlassungen — Produktionen werden von Düsseldorf aus geplant, Anfahrt transparent im Angebot.</p>
          <a class="cine-link" href="/standorte/"><span>Alle Einsatzorte</span><span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- Finale -->
    <section class="ld-finale ld-finale--media">
      <div class="ld-finale__media" aria-hidden="true">
        <video muted loop playsinline preload="none" poster="/media/hero-poster.jpg" width="1280" height="720" data-finale-video>
          <source src="/media/hero-loop.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="ld-finale__portal" aria-hidden="true"></div>
      <div class="ld-finale__horizon" aria-hidden="true"></div>
      <div class="ld-finale__slit" aria-hidden="true"></div>
      <div class="cine-wrap ld-finale__content">
        <h2 class="ld-finale__title">Welche Leistung braucht Ihr <em>Projekt</em>?</h2>
        <p class="cine-lead">Wenn das noch offen ist: kein Problem. Beschreiben Sie den Anlass — Sophia schlägt den passenden Rahmen vor.</p>
        <a class="cine-btn finale__cta" href="/kontakt/" data-magnetic>Projekt besprechen</a>
        <p class="u-meta" style="color: #8d86a0;">Düsseldorf · Antwort meist innerhalb von zwei Werktagen</p>
      </div>
    </section>
  </div>

  <script>
    import "../scripts/landing-motion.ts";
  </script>
</BaseLayout>
