---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowLink from "../components/ArrowLink.astro";
---
<BaseLayout title="Seite nicht gefunden | Sophia Ramahi" description="Die angeforderte Seite wurde nicht gefunden." noindex>
  <section class="cine-page-hero cine-page-hero--compact"><div class="layer"><img src="/media/light-void.jpg" alt="" width="1600" height="900" /></div><div class="scrim scrim--soft"></div><div class="cine-page-hero__content" data-reveal><span class="cine-label">Fehler 404</span><h1 class="cine-display">Diese Seite ist nicht mehr hier.</h1><p class="cine-lead">Vielleicht hilft der direkte Weg zu den Arbeiten oder Leistungen.</p><div class="button-row"><ArrowLink href="/arbeiten/" label="Arbeiten ansehen" class="cine-btn" /><ArrowLink href="/" label="Zur Startseite" /></div></div></section>
</BaseLayout>
