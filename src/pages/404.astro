---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowLink from "../components/ArrowLink.astro";
import { srcsetFor } from "../lib/responsive";
---
<BaseLayout title="Seite nicht gefunden | Sophia Ramahi" description="Die angeforderte Seite wurde nicht gefunden." noindex>
  <section class="cine-page-hero cine-page-hero--compact"><div class="layer"><img src="/media/light-void.jpg" srcset={srcsetFor("/media/light-void.jpg")} sizes="100vw" alt="" width="1600" height="900" loading="eager" decoding="async" /></div><div class="scrim scrim--soft"></div><div class="cine-page-hero__content" data-reveal><span class="cine-label">Fehler 404</span><h1 class="cine-display">Diese Szene ist dem Schnitt zum Opfer gefallen.</h1><p class="cine-lead">Die Adresse existiert nicht mehr oder hat sich geändert. Der schnellste Weg zurück führt über die Projekte oder die Leistungen.</p><div class="button-row"><ArrowLink href="/arbeiten/" label="Projekte ansehen" class="cine-btn" /><ArrowLink href="/leistungen/" label="Leistungen" /><ArrowLink href="/" label="Zur Startseite" /></div></div></section>
</BaseLayout>
