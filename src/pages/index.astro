---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home.css";
import { locations, projects, services, servicePath } from "../data/site";
import { srcsetFor } from "../lib/responsive";

// Purple Frame v2 — die Startseite als zusammenhängende Scroll-Erzählung.
// Alle Inhalte sind echter HTML-Text; GSAP ist reines Progressive Enhancement.

const reiseFrames = ["electric-lights", "dark-lights", "24h-to-take", "spektra-festival"].map(
  (slug) => projects.find((item) => item.slug === slug)!
);

const stageMedia: Record<string, { src: string; alt: string }> = {
  eventfilm: { src: "/media/spektra-buehne-03.jpg", alt: "" },
  musikvideo: { src: "/media/spektra-buehne-02.jpg", alt: "" },
  imagefilm: { src: "/media/journal-01.jpg", alt: "" },
  "kamera-bildgestaltung": { src: "/media/spektra-set-hoch.jpg", alt: "" },
  tonaufnahme: { src: "/media/set-hoch-02.jpg", alt: "" },
  "live-visuals": { src: "/media/club-projektion-01.jpg", alt: "" },
  "projection-mapping": { src: "/media/spektra-detail-03.jpg", alt: "" },
};

const buehneOrder = [
  "eventfilm",
  "musikvideo",
  "imagefilm",
  "kamera-bildgestaltung",
  "tonaufnahme",
  "postproduktion",
  "live-visuals",
  "projection-mapping",
];
const chapters = buehneOrder.map((slug) => services.find((service) => service.slug === slug)!);

const filmstripStills = [
  { src: "/media/spektra-detail-01.jpg" },
  { src: "/media/club-projektion-03.jpg" },
  { src: "/media/spektra-buehne-06.jpg" },
];

// Manifest: Wörter, die das Licht nacheinander sichtbar macht.
// Trägt zugleich die Kernaussage fürs Ranking: Videografin Düsseldorf / NRW.
const manifestWords: { word: string; accent: boolean; break: boolean }[] = [
  { word: "Videografin", accent: false, break: false },
  { word: "in", accent: false, break: false },
  { word: "Düsseldorf.", accent: true, break: false },
  { word: "Kamera,", accent: false, break: true },
  { word: "Licht", accent: false, break: false },
  { word: "und", accent: false, break: false },
  { word: "Schnitt", accent: false, break: false },
  { word: "—", accent: false, break: false },
  { word: "für", accent: false, break: true },
  { word: "Musik,", accent: false, break: false },
  { word: "Kultur", accent: false, break: false },
  { word: "und", accent: false, break: false },
  { word: "Events", accent: false, break: false },
  { word: "in", accent: false, break: true },
  { word: "ganz", accent: false, break: false },
  { word: "NRW.", accent: false, break: false },
];

const duesseldorf = locations.find((location) => location.slug === "duesseldorf")!;
const regionGroups = [
  { label: "Rheinland", slugs: ["koeln", "neuss", "meerbusch", "leverkusen", "bonn"] },
  { label: "Niederrhein & Kreis Mettmann", slugs: ["krefeld", "moenchengladbach", "ratingen"] },
  { label: "Bergisches Land", slugs: ["wuppertal", "solingen"] },
  { label: "Ruhrgebiet", slugs: ["essen", "duisburg", "oberhausen", "bochum", "dortmund"] },
].map((group) => ({
  label: group.label,
  items: group.slugs.map((slug) => locations.find((location) => location.slug === slug)!),
}));

/* NRW-Lichtnetz: echte Relativpositionen der Einsatzorte (Luftlinie ab
   Düsseldorf). Die Karte ist dekorativ (aria-hidden) — der zugängliche
   Inhalt bleibt die Ortsliste daneben. */
const cityGeo: Record<string, { lat: number; lon: number }> = {
  duesseldorf: { lat: 51.2277, lon: 6.7735 },
  koeln: { lat: 50.9375, lon: 6.9603 },
  neuss: { lat: 51.2042, lon: 6.6879 },
  ratingen: { lat: 51.2973, lon: 6.8492 },
  meerbusch: { lat: 51.2664, lon: 6.6866 },
  krefeld: { lat: 51.3388, lon: 6.5853 },
  wuppertal: { lat: 51.2562, lon: 7.1508 },
  essen: { lat: 51.4556, lon: 7.0116 },
  duisburg: { lat: 51.4344, lon: 6.7623 },
  moenchengladbach: { lat: 51.1805, lon: 6.4428 },
  leverkusen: { lat: 51.0459, lon: 6.9853 },
  bonn: { lat: 50.7374, lon: 7.0982 },
  bochum: { lat: 51.4818, lon: 7.2162 },
  dortmund: { lat: 51.5136, lon: 7.4653 },
  oberhausen: { lat: 51.4696, lon: 6.8514 },
  solingen: { lat: 51.1652, lon: 7.067 },
};
const MAP_W = 640;
const MAP_H = 760;
const MAP_PAD = 76;
const lats = Object.values(cityGeo).map((g) => g.lat);
const lons = Object.values(cityGeo).map((g) => g.lon);
const latMin = Math.min(...lats);
const latMax = Math.max(...lats);
const lonMin = Math.min(...lons);
const lonMax = Math.max(...lons);
const lonShrink = Math.cos(((latMin + latMax) / 2 / 180) * Math.PI);
const spanX = (lonMax - lonMin) * lonShrink;
const spanY = latMax - latMin;
const mapScale = Math.min((MAP_W - 2 * MAP_PAD) / spanX, (MAP_H - 2 * MAP_PAD) / spanY);
const mapX = (lon: number) => MAP_PAD + (MAP_W - 2 * MAP_PAD - spanX * mapScale) / 2 + (lon - lonMin) * lonShrink * mapScale;
const mapY = (lat: number) => MAP_PAD + (MAP_H - 2 * MAP_PAD - spanY * mapScale) / 2 + (latMax - lat) * mapScale;
const beelineKm = (a: { lat: number; lon: number }, b: { lat: number; lon: number }) => {
  const rad = (v: number) => (v / 180) * Math.PI;
  const h =
    Math.sin(rad(b.lat - a.lat) / 2) ** 2 +
    Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(rad(b.lon - a.lon) / 2) ** 2;
  return Math.round(6371 * 2 * Math.asin(Math.sqrt(h)));
};
const dusGeo = cityGeo.duesseldorf;
const mapNodes = locations
  .filter((location) => cityGeo[location.slug])
  .map((location) => {
    const geoPoint = cityGeo[location.slug];
    return {
      slug: location.slug,
      city: location.city,
      x: Math.round(mapX(geoPoint.lon) * 10) / 10,
      y: Math.round(mapY(geoPoint.lat) * 10) / 10,
      km: beelineKm(dusGeo, geoPoint),
      isBase: location.slug === "duesseldorf",
    };
  });
const mapBase = mapNodes.find((node) => node.isBase)!;

const cutSteps = [
  { key: "gespraech", title: "Gespräch", copy: "Ziel, Publikum, Ort und ein realistischer Rahmen — geklärt, bevor Technik eine Rolle spielt." },
  { key: "konzeption", title: "Konzeption", copy: "Bildidee, Licht, Ton, Ablauf und Verantwortlichkeiten werden so konkret wie nötig geplant." },
  { key: "dreh", title: "Dreh", copy: "Konzentriert drehen oder live gestalten, ohne den Raum unnötig zu blockieren." },
  { key: "schnitt", title: "Schnitt & Ton", copy: "Material ordnen, den Rhythmus finden und Bild und Ton präzise verbinden." },
  { key: "uebergabe", title: "Übergabe", copy: "Abgestimmte Formate für Website, Social Media und Archiv — sauber dokumentiert übergeben." },
];
---

<BaseLayout title="Sophia Ramahi | Videografin & Visual Artist in Düsseldorf" description="Videografie, Kamera, Ton, Postproduktion, VJ und Projection Mapping aus Düsseldorf – für Musik, Kultur, Events und ausgewählte Unternehmen.">
  <div class="home" data-home>
    <!-- 1 · Ouvertüre: Aus dem Lichtspalt öffnet sich das laufende Bild -->
    <section class="ouv" aria-label="Einstieg">
      <div class="ouv__media" aria-hidden="true">
        <video muted loop playsinline preload="metadata" poster="/media/hero-poster.jpg" width="1280" height="720" data-hero-video>
          <source src="/media/hero-loop.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="ouv__shutter ouv__shutter--left" aria-hidden="true"></div>
      <div class="ouv__shutter ouv__shutter--right" aria-hidden="true"></div>
      <div class="ouv__slit" aria-hidden="true"></div>
      <div class="cine-wrap ouv__content">
        <h1 class="ouv__title">
          <span class="ouv__line ouv__line--1">Film.</span>
          <span class="ouv__line ouv__line--2">Licht.</span>
          <span class="ouv__line ouv__line--3">Bewegung.</span>
        </h1>
        <p class="ouv__sub">Videografie, Kamera und visuelle Räume von Sophia Ramahi in Düsseldorf.</p>
        <div class="ouv__actions">
          <a class="cine-btn" href="/arbeiten/">Arbeiten ansehen</a>
          <a class="cine-ghost" href="/kontakt/">Projekt anfragen</a>
        </div>
      </div>
      <p class="ouv__scroll" aria-hidden="true">Scrollen</p>
    </section>

    <!-- 2 · Manifest: Licht macht den Satz sichtbar -->
    <section class="manifest" aria-label="Positionierung">
      <div class="manifest__sticky">
        <div class="manifest__cone" aria-hidden="true"></div>
        <div class="manifest__glow" aria-hidden="true"></div>
        <div class="manifest__floor" aria-hidden="true"></div>
        <h2 class="manifest__quote">
          {manifestWords.map((item) => (
            <>
              {item.break && <br />}
              <span class:list={["manifest__word", { "manifest__word--accent": item.accent }]}>{item.word}</span>{" "}
            </>
          ))}
        </h2>
      </div>
    </section>

    <!-- 3 · Projektreise -->
    <section class="reise" id="projekte">
      <div class="reise__stage">
        <header class="cine-wrap reise__head">
          <div>
            <span class="cine-label">Ausgewählte Arbeiten</span>
            <h2 class="cine-h2">Vier Projekte, vier Bildwelten.</h2>
          </div>
          <p class="reise__counter u-meta" aria-hidden="true"><span data-reise-current>01</span><span class="reise__counter-sep">/</span>04</p>
        </header>
        <div class="reise__viewport">
          <div class="reise__track">
            {reiseFrames.map((project, index) => (
              <a class:list={["reise__frame", { "reise__frame--electric": project.slug === "electric-lights" }]} href={`/projekte/${project.slug}/`}>
                <img src={project.image} srcset={srcsetFor(project.image)} sizes="(min-width: 861px) 58vw, 94vw" alt={project.alt} width="1200" height="675" loading="lazy" decoding="async" />
                <span class="reise__scrim" aria-hidden="true"></span>
                <span class="reise__index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <span class="reise__meta">
                  <span class="cine-label">{project.category}{project.year ? ` · ${project.year}` : ""}</span>
                  <span class="reise__title">{project.title}</span>
                  <span class="reise__role">{project.roles.slice(0, 2).join(" · ")}</span>
                  <span class="reise__go">Projekt ansehen <span aria-hidden="true">→</span></span>
                </span>
              </a>
            ))}
          </div>
        </div>
        <div class="cine-wrap reise__foot">
          <div class="reise__progress" aria-hidden="true"><i></i></div>
          <a class="cine-link" href="/arbeiten/"><span>Alle Projekte</span><span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- 4 · Showreel: Kinosaal -->
    <section class="reel" id="showreel">
      <div class="reel__sticky">
        <div class="reel__beam" aria-hidden="true"></div>
        <div class="cine-wrap reel__head">
          <span class="cine-label">Showreel</span>
          <h2 class="cine-h2">Kamera, Licht, Rhythmus.</h2>
        </div>
        <div class="cine-wrap reel__body">
          <div class="reel__frame" data-reel>
            <video controls preload="none" poster="/media/hero-poster.jpg" width="1920" height="1080">
              <source src="/media/showreel.mp4" type="video/mp4" />
              Ihr Browser kann das Video nicht wiedergeben.
            </video>
            <span class="reel__bar reel__bar--top" aria-hidden="true"></span>
            <span class="reel__bar reel__bar--bottom" aria-hidden="true"></span>
            <button class="reel__play" type="button" data-reel-play hidden>
              <span class="reel__play-ring" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
              </span>
              <span>Showreel abspielen</span>
            </button>
            <div class="reel__ui" data-reel-ui hidden>
              <button class="reel__ui-btn" type="button" data-reel-toggle aria-label="Pause">
                <svg class="reel__icon-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 5h3.4v14H7zm6.6 0H17v14h-3.4z" fill="currentColor" /></svg>
                <svg class="reel__icon-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
              </button>
              <div class="reel__scrub" data-reel-scrub role="slider" aria-label="Position im Showreel" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
                <i class="reel__scrub-fill" data-reel-fill></i>
                <i class="reel__scrub-knob" data-reel-knob></i>
              </div>
              <span class="reel__time u-num" data-reel-time>0:00 / 0:48</span>
              <span class="reel__silent u-meta">Ohne Ton</span>
              <button class="reel__ui-btn" type="button" data-reel-full aria-label="Vollbild">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
              </button>
            </div>
          </div>
          <p class="reel__note u-caption">Showreel · 48 Sekunden · bewusst ohne Ton</p>
        </div>
      </div>
    </section>

    <!-- 5 · Leistungen als Kapitel -->
    <section class="buehne" id="leistungen">
      <div class="cine-wrap buehne__head">
        <span class="cine-label">Leistungen</span>
        <h2 class="cine-h2">Vom ersten Bild bis zur fertigen Ausspielung</h2>
        <p class="cine-lead">Acht Gewerke, einzeln buchbar — zusammen eine Produktion.</p>
      </div>
      <div class="buehne__layout">
        <div class="buehne__stage" aria-hidden="true">
          {chapters.map((service, index) => {
            const media = stageMedia[service.slug];
            return (
              <div class:list={["buehne__medium", { "is-active": index === 0 }]} data-medium={service.slug}>
                {service.slug === "postproduktion" ? (
                  <span class="buehne__strip">
                    {filmstripStills.map((still) => (
                      <span class="buehne__still"><img src={still.src} srcset={srcsetFor(still.src)} sizes="(min-width: 861px) 19vw, 31vw" alt="" width="480" height="320" loading="lazy" decoding="async" /></span>
                    ))}
                    <span class="buehne__playhead"></span>
                  </span>
                ) : (
                  <img src={media.src} srcset={srcsetFor(media.src)} sizes="(min-width: 861px) 56vw, 94vw" alt="" width="1200" height="800" loading="lazy" decoding="async" />
                )}
                {service.slug === "projection-mapping" && <span class="buehne__grid"></span>}
              </div>
            );
          })}
          <span class="buehne__finder" aria-hidden="true">
            <i class="buehne__tick buehne__tick--tl"></i>
            <i class="buehne__tick buehne__tick--tr"></i>
            <i class="buehne__tick buehne__tick--bl"></i>
            <i class="buehne__tick buehne__tick--br"></i>
            <span class="buehne__finder-meta">
              <i class="buehne__dot"></i>
              <span data-stage-label>K 01 · Eventfilm</span>
            </span>
            <span class="buehne__finder-count" data-stage-count>01 / 08</span>
          </span>
        </div>
        <div class="buehne__chapters">
          {chapters.map((service, index) => {
            const media = stageMedia[service.slug];
            return (
              <a class="buehne__chapter" href={servicePath(service)} data-chapter={service.slug} data-chapter-title={service.title} data-chapter-index={String(index + 1).padStart(2, "0")}>
                <span class="buehne__ghost" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <span class="buehne__band" aria-hidden="true">
                  {service.slug === "postproduktion" ? (
                    <span class="buehne__strip buehne__strip--band">
                      {filmstripStills.map((still) => (
                        <span class="buehne__still"><img src={still.src} srcset={srcsetFor(still.src)} sizes="(min-width: 861px) 19vw, 31vw" alt="" width="480" height="320" loading="lazy" decoding="async" /></span>
                      ))}
                    </span>
                  ) : (
                    <img src={media.src} srcset={srcsetFor(media.src)} sizes="94vw" alt="" width="960" height="410" loading="lazy" decoding="async" />
                  )}
                </span>
                <span class="cine-label">{service.eyebrow}</span>
                <h3>{service.title}</h3>
                <p>{service.summary}</p>
                <span class="buehne__go">Zur Leistung <span aria-hidden="true">→</span></span>
              </a>
            );
          })}
        </div>
      </div>
      <div class="cine-wrap buehne__foot">
        <a class="cine-link" href="/leistungen/"><span>Alle Leistungen im Überblick</span><span aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- 6 · Über Sophia: Abspann-Konzept — ein Set, eine Handschrift -->
    <section class="portraet" id="ueber-sophia">
      <span class="portraet__ghost" aria-hidden="true">Sophia</span>
      <div class="portraet__glow" aria-hidden="true"></div>
      <div class="cine-wrap portraet__grid">
        <div class="portraet__copy">
          <span class="cine-label">Über Sophia</span>
          <h2 class="portraet__title">Technik schafft den Rahmen. <em>Atmosphäre</em> macht den Film.</h2>
          <ol class="portraet__credits" aria-label="Was Sophia übernimmt">
            <li class="portraet__credit"><span class="portraet__role">Kamera</span><i aria-hidden="true"></i><span class="portraet__name">nah dran, ohne zu stören</span></li>
            <li class="portraet__credit"><span class="portraet__role">Licht</span><i aria-hidden="true"></i><span class="portraet__name">Atmosphäre statt Ausleuchtung</span></li>
            <li class="portraet__credit"><span class="portraet__role">Ton</span><i aria-hidden="true"></i><span class="portraet__name">verständlich und räumlich</span></li>
            <li class="portraet__credit"><span class="portraet__role">Schnitt</span><i aria-hidden="true"></i><span class="portraet__name">Rhythmus und Dramaturgie</span></li>
            <li class="portraet__credit"><span class="portraet__role">Live Visuals</span><i aria-hidden="true"></i><span class="portraet__name">Bilder, die live reagieren</span></li>
          </ol>
          <p class="portraet__claim">Ausgebildete Mediengestalterin Bild und Ton — ein Set, eine Handschrift: Sophia Ramahi. Und wenn ein Projekt mehr braucht, holt sie das passende Team dazu.</p>
          <a class="cine-link" href="/ueber-sophia/"><span>Mehr über die Zusammenarbeit</span><span aria-hidden="true">→</span></a>
        </div>
        <figure class="portraet__frame">
          <img src="/media/sophia-portrait.jpg" srcset={srcsetFor("/media/sophia-portrait.jpg")} sizes="(min-width: 861px) 38vw, 86vw" alt="Sophia Ramahi, Videografin aus Düsseldorf" width="900" height="1100" loading="lazy" decoding="async" />
          <span class="portraet__tint" aria-hidden="true"></span>
          <span class="portraet__rail u-meta" aria-hidden="true">Sophia Ramahi · Mediengestalterin Bild & Ton</span>
        </figure>
      </div>
    </section>

    <!-- 7 · Prozess als Schnitt-Timeline -->
    <section class="cut" id="prozess">
      <div class="cut__sticky">
        <div class="cine-wrap cut__head">
          <span class="cine-label">Zusammenarbeit</span>
          <h2 class="cine-h2">Vom ersten Gespräch zum fertigen Film</h2>
        </div>
        <div class="cine-wrap cut__screen">
          {cutSteps.map((step, index) => (
            <div class:list={["cut__step", { "is-active": index === 0 }]} data-step={index}>
              <span class="cut__num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </div>
          ))}
        </div>
        <div class="cine-wrap">
          <div class="cut__timeline" aria-hidden="true">
            <span class="cut__playhead"><i></i></span>
            {cutSteps.map((step, index) => (
              <span class:list={["cut__clip", { "is-active": index === 0 }]} data-clip={index}>
                <i class="cut__fill"></i>
                <span class="cut__clip-label">{String(index + 1).padStart(2, "0")} · {step.title}</span>
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 8 · Düsseldorf & NRW -->
    <section class="region" id="einsatzgebiet">
      <div class="cine-wrap">
        <div class="region__head">
          <span class="cine-label">Düsseldorf & NRW</span>
          <h2 class="cine-h2">Die Basis ist Düsseldorf. Produziert wird, wo das Projekt stattfindet.</h2>
        </div>
        <div class="region__layout">
          <div class="region__content">
            <a class="region__basis" href={`/standorte/${duesseldorf.slug}/`} data-city="duesseldorf">
              <span class="region__basis-name">Düsseldorf</span>
              <span class="u-meta">Basis · Vorgespräche & Produktionen</span>
            </a>
            <div class="region__groups">
              {regionGroups.map((group) => (
                <div class="region__group">
                  <span class="region__beam" aria-hidden="true"></span>
                  <h3 class="u-meta">{group.label}</h3>
                  <p class="region__cities">
                    {group.items.map((location) => (
                      <a href={`/standorte/${location.slug}/`} data-city={location.slug}>{location.city}</a>
                    ))}
                  </p>
                </div>
              ))}
            </div>
            <div class="region__foot">
              <p class="u-caption">Keine Niederlassungen — Produktionen werden von Düsseldorf aus geplant, Anfahrt transparent im Angebot.</p>
              <a class="cine-link" href="/standorte/"><span>Alle Einsatzorte</span><span aria-hidden="true">→</span></a>
            </div>
          </div>
          <!-- Lichtnetz: Luftlinien ab Düsseldorf, Positionen aus echten
               Koordinaten. Beim Überfahren der Ortsnamen leuchtet der
               zugehörige Punkt auf (site.ts). -->
          <figure class="region__map" aria-hidden="true">
            <svg viewBox={`0 0 ${MAP_W} ${MAP_H}`} fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <radialGradient id="rmap-halo" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="rgba(154, 92, 255, 0.5)" />
                  <stop offset="100%" stop-color="rgba(154, 92, 255, 0)" />
                </radialGradient>
              </defs>
              <text class="rmap__ghost" x={MAP_W / 2} y={MAP_H / 2}>NRW</text>
              {mapNodes.filter((node) => !node.isBase).map((node) => (
                <line
                  class="rmap__ray"
                  x1={mapBase.x}
                  y1={mapBase.y}
                  x2={node.x}
                  y2={node.y}
                  pathLength="1"
                  data-city-ray={node.slug}
                />
              ))}
              {mapNodes.map((node) => (
                <g class:list={["rmap__node", { "rmap__node--base": node.isBase }]} data-city-dot={node.slug}>
                  <circle class="rmap__halo" cx={node.x} cy={node.y} r={node.isBase ? 30 : 18} fill="url(#rmap-halo)" />
                  {node.isBase && <circle class="rmap__ring" cx={node.x} cy={node.y} r="13" />}
                  <circle class="rmap__dot" cx={node.x} cy={node.y} r={node.isBase ? 5.5 : 3.5} />
                  <text class="rmap__name" x={node.x} y={node.y - (node.isBase ? 24 : 14)}>
                    {node.isBase ? node.city : `${node.city} · ${node.km} km`}
                  </text>
                </g>
              ))}
            </svg>
          </figure>
        </div>
      </div>
    </section>

    <!-- 9 · Finale: das Licht kehrt zurück -->
    <section class="finale" id="kontakt">
      <div class="finale__media" aria-hidden="true">
        <video muted loop playsinline preload="none" poster="/media/hero-poster.jpg" width="1280" height="720" data-finale-video>
          <source src="/media/hero-loop.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="finale__portal" aria-hidden="true"></div>
      <div class="finale__horizon" aria-hidden="true"></div>
      <div class="finale__slit" aria-hidden="true"></div>
      <div class="cine-wrap finale__content">
        <h2 class="finale__title">
          <span class="finale__title-line">Der nächste Film beginnt</span>
          <span class="finale__title-line">mit einem <em>Gespräch</em>.</span>
        </h2>
        <p class="cine-lead">Erzählen Sie Sophia, was entstehen soll — ein paar Sätze reichen für den Anfang.</p>
        <a class="cine-btn finale__cta" href="/kontakt/" data-magnetic>Projekt besprechen</a>
        <p class="finale__meta u-meta">Düsseldorf · Antwort meist innerhalb von zwei Werktagen</p>
      </div>
    </section>
  </div>

  <script>
    import "../scripts/home-motion.ts";
  </script>
</BaseLayout>
