---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactCta from "../../components/ContactCta.astro";
import PageHero from "../../components/PageHero.astro";
import { locations } from "../../data/site";
---
<BaseLayout title="Drehorte in NRW | Anfahrt & Planung von Sophia Ramahi" description="Dreh und Veranstaltung in Düsseldorf, Rheinland, Niederrhein oder Ruhrgebiet planen: Sophias Basis, Anfahrt, Zugänge und Einsatzorte im Überblick.">
  <PageHero title="Drehorte in Düsseldorf und NRW" lead="Sophias Produktionsbasis ist Düsseldorf. Für Drehs und Live Visuals in NRW werden Ort, Reise und technischer Ablauf gemeinsam geplant." image="/media/light-beams.jpg" alt="Abstrakte Lichtstrahlen" crumbs={[{label:"Start",href:"/"},{label:"Standorte"}]} />
  <section class="section cine-wrap section--split"><div data-reveal><span class="cine-label">Regional produzieren</span><h2 class="cine-h2">Was muss am Drehort geklärt werden?</h2></div><div class="prose" data-reveal><p>Für passende Produktionen reist Sophia von Düsseldorf aus an. Die Einsatzort-Seiten helfen bei der Vorbereitung: Wo finden Aufnahmen oder Veranstaltung statt, wann sind Zugänge offen und wo können Technik und Material eingerichtet werden?</p><p>Für Orte außerhalb der aufgeführten Region genügt eine kurze Anfrage. Reise, Techniktransport und gegebenenfalls Übernachtung werden für den konkreten Ablauf kalkuliert und vor der Beauftragung vereinbart.</p></div></section>
  <section class="section section--surface"><div class="cine-wrap"><div class="location-grid">{locations.map((location)=><a href={`/standorte/${location.slug}/`} data-reveal><span class="cine-label">{location.region} · {location.distance}</span><h2>{location.city}</h2><p>{location.intro}</p><span>Details zur Produktion ↗</span></a>)}</div></div></section>
  <ContactCta title="Ihr Ort ist nicht dabei?" copy="Nennen Sie Ort, Termin und Projektart. Sophia prüft direkt, ob die Produktion sinnvoll planbar ist." />
</BaseLayout>
