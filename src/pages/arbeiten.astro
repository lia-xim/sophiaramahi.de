---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/landing.css";
import { projects } from "../data/site";
import { srcsetFor } from "../lib/responsive";

// Projekte als Lichttisch: Das 2×2-Raster ist der Einstieg — vier dunkle
// Kacheln, die sich beim Scrollen erhellen. Danach das Labor-Kapitel,
// der Projektindex, das Showreel-Band und das Portal-Finale.
const tiles = projects;
const indexMeta: Record<string, string> = {
  "electric-lights": "Konzept, Kamera & Licht, Klang-Komposition, Schnitt",
  "dark-lights": "Bildidee, Lichtgestaltung, Fotografie",
  "24h-to-take": "Teilnahme, Organisation, Technik, Jury",
  "spektra-festival": "Live Visuals, Projektion, Aufbau, Dokumentation",
};
---

<BaseLayout title="Projekte | Filme, Visuals & Installationen von Sophia Ramahi" description="Ausgewählte Projekte von Sophia Ramahi: Electric Lights, Dark Lights, 24h to take und Spektra Festival — Installationen, Lichtstudien, Wettbewerbe und Live Visuals.">
  <div data-landing>
    <!-- 1 · Lichttisch: Headline über dem dunklen Raster, das aufleuchtet -->
    <section class="pj-stage" data-projekt-grid aria-label="Ausgewählte Projekte">
      <div class="pj-sticky">
        <header class="pj-head cine-wrap">
          <p class="pj-kicker">Ausgewählte Arbeiten</p>
          <h1 class="pj-title">Vier Projekte, vier <em>Bildwelten</em>.</h1>
          <p class="pj-sub">Installation, Lichtstudie, Wettbewerb, Festival — jedes Projekt beginnt bei seinem Material: Musik, Raum, Menschen, Licht.</p>
          <p class="pj-scroll" aria-hidden="true">Scrollen</p>
        </header>
        <div class="pj-grid">
          {tiles.map((project, index) => (
            <a class:list={["pj-tile", { "pj-tile--electric": project.slug === "electric-lights" }]} href={`/projekte/${project.slug}/`}>
              <img src={project.image} srcset={srcsetFor(project.image)} sizes="(min-width: 901px) 48vw, 92vw" alt={project.alt} width="960" height="600" loading="eager" fetchpriority={index === 0 ? "high" : undefined} decoding="async" />
              <span class="pj-tile__dim" aria-hidden="true"></span>
              <span class="pj-tile__meta">
                <span class="cine-label">{String(index + 1).padStart(2, "0")} · {project.category}{project.year ? ` · ${project.year}` : ""}</span>
                <span class="pj-tile__title">{project.title}</span>
                <span class="pj-tile__go">Projekt ansehen <span aria-hidden="true">→</span></span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 2 · Worum es hier geht: das Labor hinter den Produktionen -->
    <section class="cine-wrap ld-split">
      <div class="ld-split__head" data-fx="rise">
        <span class="cine-label">Warum freie Projekte</span>
        <h2>Das Labor hinter den Produktionen</h2>
      </div>
      <div class="ld-split__prose" data-fx="rise">
        <p>Ausstellungen, Wettbewerbe, Studentenfilme und eigene kreative Arbeiten: Hier probiert Sophia aus, was sich später im Auftrag bewähren muss — Lichtgestaltung, Klang, Erzählformen und der Mut zu eigenen Bildern.</p>
        <p>Diese Projekte bereichern die Perspektive und bringen neue Ansätze in jede Produktion. Wer bei 24h to take in einem Tag plant, dreht und schneidet, bleibt auch dann ruhig, wenn am Set Zeit und Technik knapp werden.</p>
        <p>Jedes der vier Projekte steht deshalb für mehr als sein Ergebnis: Es zeigt eine Arbeitsweise — vorbereitet, aufmerksam und nah am Material.</p>
      </div>
    </section>

    <!-- 3 · Projektindex -->
    <section class="cine-wrap pj-index" aria-label="Projektindex">
      {tiles.map((project, index) => (
        <a class="pj-index__row" href={`/projekte/${project.slug}/`} data-fx="rise">
          <span class="pj-index__num">{String(index + 1).padStart(2, "0")}</span>
          <span class="pj-index__title">{project.title}</span>
          <span class="pj-index__meta">
            {project.category}
            {project.year ? ` · ${project.year}` : ""}
            {project.location ? ` · ${project.location}` : ""}
            <br />
            {indexMeta[project.slug]}
          </span>
          <span class="pj-index__go" aria-hidden="true">→</span>
        </a>
      ))}
    </section>

    <!-- 4 · Showreel-Band -->
    <section class="pj-reel">
      <div class="pj-reel__beam" aria-hidden="true"></div>
      <span class="cine-label" data-fx="rise">Showreel</span>
      <h2 data-fx="rise">48 Sekunden Kamera, Licht und Rhythmus.</h2>
      <p data-fx="rise">Der schnellste Weg, Sophias Bildsprache kennenzulernen — dokumentarisch, inszeniert und live entstanden.</p>
      <div data-fx="rise"><a class="cine-btn" href="/showreel/">Showreel ansehen</a></div>
    </section>

    <!-- 5 · Finale: das Licht kehrt zurück -->
    <section class="ld-finale ld-finale--media">
      <div class="ld-finale__media" aria-hidden="true">
        <video muted loop playsinline preload="none" poster="/media/hero-poster.jpg" width="1280" height="720" data-finale-video>
          <source src="/media/hero-loop.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="ld-finale__portal" aria-hidden="true"></div>
      <div class="ld-finale__horizon" aria-hidden="true"></div>
      <div class="ld-finale__slit" aria-hidden="true"></div>
      <div class="cine-wrap ld-finale__content">
        <h2 class="ld-finale__title">Ein ähnlicher Rahmen, aber eine <em>eigene</em> Idee?</h2>
        <p class="cine-lead">Erzählen Sie Sophia, was entstehen soll — ein paar Sätze reichen für den Anfang.</p>
        <a class="cine-btn finale__cta" href="/kontakt/" data-magnetic>Projekt besprechen</a>
        <p class="u-meta" style="color: #8d86a0;">Düsseldorf · Antwort meist innerhalb von zwei Werktagen</p>
      </div>
    </section>
  </div>

  <script>
    import "../scripts/landing-motion.ts";
  </script>
</BaseLayout>
