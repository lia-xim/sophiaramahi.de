---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArrowLink from "../../components/ArrowLink.astro";
import ContactCta from "../../components/ContactCta.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { articles, type Article } from "../../data/site";
import Pic from "../../components/Pic.astro";
export function getStaticPaths(){return articles.map((article)=>({params:{slug:article.slug},props:{article}}));}
const {article}=Astro.props as {article:Article};
const date=new Intl.DateTimeFormat("de-DE",{dateStyle:"long"}).format(new Date(article.publishedAt));
// Blättern in Lesereihenfolge: neueste zuerst, wie auf der Übersicht.
const ordered=[...articles].sort((a,b)=>b.publishedAt.localeCompare(a.publishedAt));
const position=ordered.findIndex((item)=>item.slug===article.slug);
const previousArticle=position>0?ordered[position-1]:null;
const nextArticle=position<ordered.length-1?ordered[position+1]:null;
const schema={"@context":"https://schema.org","@type":"BlogPosting",headline:article.title,description:article.excerpt,image:`https://sophiaramahi.de${article.image}`,datePublished:article.publishedAt,dateModified:article.publishedAt,author:{"@id":"https://sophiaramahi.de/#person"},mainEntityOfPage:`https://sophiaramahi.de/journal/${article.slug}/`};
---
<BaseLayout title={article.title} description={article.excerpt} image={article.image} imageAlt={article.title} article publishedAt={article.publishedAt} schema={schema}>
  <span class="article-progress" aria-hidden="true"><i data-article-progress></i></span>
  <article data-article>
    <header class="article-hero cine-wrap"><Breadcrumbs items={[{label:"Start",href:"/"},{label:"Journal",href:"/journal/"},{label:article.title}]} /><span class="cine-label">{date} · {article.readingTime}</span><h1 class="cine-display">{article.title}</h1><p class="cine-lead">{article.excerpt}</p><Pic src={article.image} sizes="(min-width: 1240px) 1160px, 94vw" alt={article.title} width="1400" height="850" loading="eager" fetchpriority="high" /></header>
    <div class="article-body cine-wrap">{article.sections.map((section)=><section data-reveal><h2>{section.title}</h2>{section.copy.map((paragraph)=><p>{paragraph}</p>)}</section>)}<aside><span class="cine-label">Weiterlesen</span>{article.related.map((item)=><ArrowLink href={item.href} label={item.label} />)}</aside></div>
    <nav class="article-turn cine-wrap" aria-label="Weitere Beiträge">
      {previousArticle ? (
        <a class="article-turn__card" href={`/journal/${previousArticle.slug}/`} rel="prev">
          <span class="u-meta">← Neuerer Beitrag</span>
          <span class="article-turn__title">{previousArticle.title}</span>
        </a>
      ) : <span class="article-turn__card article-turn__card--empty" aria-hidden="true"></span>}
      {nextArticle ? (
        <a class="article-turn__card article-turn__card--next" href={`/journal/${nextArticle.slug}/`} rel="next">
          <span class="u-meta">Älterer Beitrag →</span>
          <span class="article-turn__title">{nextArticle.title}</span>
        </a>
      ) : <span class="article-turn__card article-turn__card--empty" aria-hidden="true"></span>}
    </nav>
  </article>
  <ContactCta />
  <script>
    import "../../scripts/article.ts";
  </script>
</BaseLayout>
