---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import "../styles/landing.css";
import { site } from "../data/site";
import Pic from "../components/Pic.astro";

// Über Sophia als Identitätsseite: einmal steht sie selbst vor der Kamera.
// Aufbau nach dem Muster von Startseite, Projekten und Leistungs-Hub —
// mit dem echten Kontaktformular am Seitenende.
const stations = [
  { title: "Ausbildung", copy: "Mediengestalterin Bild und Ton — abgeschlossen im Januar 2024, mit Schwerpunkt auf Kamera, Licht und Tontechnik." },
  { title: "Junge Filmwerkstatt", copy: "Medienarbeit, Social Media und Organisation im Umfeld der Jungen Filmwerkstatt Düsseldorf." },
  { title: "24h to take", copy: "Seit 2019 beim 24-Stunden-Videowettbewerb — als Teilnehmerin, in Organisation und Technik, im Livestream und in der Jury." },
  { title: "Freie Arbeiten & Aufträge", copy: "Kunstprojekte wie Electric Lights im KIT (2023), Musikvideos, Events und Kurzfilme — frei und im Auftrag." },
];
---

<BaseLayout title="Über Sophia Ramahi | Videografin aus Düsseldorf" description="Sophia Ramahi ist ausgebildete Mediengestalterin Bild und Ton, Kamerafrau und Visual Artist aus Düsseldorf.">
  <div data-landing>
    <!-- 1 · Identitäts-Hero: einmal vor der Kamera -->
    <section class="lw-hero">
      <div class="lw-hero__media" aria-hidden="true">
        <video muted loop playsinline preload="none" poster="/media/hero-poster.jpg" width="1280" height="720" data-ambient-video>
          <source src="/media/hero-loop.mp4" type="video/mp4" />
        </video>
      </div>
      <span class="sp-ghost" aria-hidden="true" data-sp-ghost>Sophia</span>
      <div class="ld-hero__beam" aria-hidden="true"></div>
      <span class="lw-dust" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span>
      <span class="lw-grain" aria-hidden="true"></span>
      <div class="cine-wrap lw-hero__grid">
        <div class="lw-hero__content">
          <Breadcrumbs items={[{ label: "Start", href: "/" }, { label: "Über Sophia" }]} />
          <p class="ld-hero__kicker">Hinter der Kamera</p>
          <h1 class="ld-hero__title">Sophia <em>Ramahi</em>.</h1>
          <p class="sp-roles"><span>Videografin</span><span>Kamerafrau</span><span>Mediengestalterin Bild & Ton</span></p>
          <p class="ld-hero__lead">Sie verbindet Kamera, Licht, Ton und Postproduktion — besonders gern bei Musik-, Kultur- und Eventformaten, die eine eigene visuelle Sprache brauchen.</p>
          <div class="ld-hero__actions">
            <a class="cine-btn" href="#anfrage">Projekt besprechen</a>
            <a class="cine-ghost" href="/arbeiten/">Projekte ansehen</a>
          </div>
          <p class="ld-hero__meta"><span>Düsseldorf</span><span>Ausbildung abgeschlossen 2024</span><span>Seit 2019 an Sets & Abläufen</span></p>
        </div>
        <figure class="sp-frame" data-fx="rise">
          <span class="sp-frame__media">
            <Pic src="/media/sophia-portrait.jpg" sizes="(min-width: 861px) 440px, 86vw" alt="Sophia Ramahi, Videografin aus Düsseldorf" width="900" height="1100" loading="eager" fetchpriority="high" />
          </span>
          <span class="lw-finder" aria-hidden="true"><i></i><i></i><i></i><i></i><span class="lw-finder__rec">Rec</span></span>
          <figcaption class="sp-frame__caption u-meta">Einmal selbst im Bild — sonst dahinter.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 2 · Arbeitsweise als Manifest: das Licht macht die Haltung sichtbar -->
    <section class="sp-manifest" aria-label="Arbeitsweise" data-sp-manifest>
      <div class="sp-manifest__sticky">
        <div class="sp-manifest__glow" aria-hidden="true"></div>
        <h2 class="sp-manifest__quote">
          <span class="sp-manifest__word">Gut</span> <span class="sp-manifest__word">vorbereitet</span> <span class="sp-manifest__word">sein.</span><br />
          <span class="sp-manifest__word">Aufmerksam</span> <span class="sp-manifest__word">beobachten.</span><br />
          <span class="sp-manifest__word">Nur</span> <span class="sp-manifest__word">eingreifen,</span> <span class="sp-manifest__word">wo</span> <span class="sp-manifest__word">es</span><br />
          <span class="sp-manifest__word">dem</span> <span class="sp-manifest__word sp-manifest__word--accent">Bild</span> <span class="sp-manifest__word">hilft.</span>
        </h2>
      </div>
    </section>
    <div class="sp-prose" data-fx="rise">
      <p>Sophia arbeitet an der Schnittstelle von Kamera, Licht, Ton und bewegtem Bild. Ihre Ausbildung zur Mediengestalterin Bild und Ton hat sie im Januar 2024 abgeschlossen — seitdem entwickelt sie ihre Arbeit in freien Produktionen, Kulturprojekten und eigenen visuellen Experimenten weiter.</p>
      <p>In der Postproduktion geht es anschließend darum, Material nicht bloß zu verkürzen, sondern seinen Rhythmus zu finden. Technik soll Möglichkeiten schaffen, nicht Aufmerksamkeit verlangen.</p>
    </div>

    <!-- 3 · Stationen -->
    <section class="cine-wrap ld-steps">
      <div class="ld-steps__head" data-fx="rise">
        <span class="cine-label">Stationen</span>
        <h2 class="cine-h2">Der Weg hinter die Kamera</h2>
      </div>
      <ol class="ld-steps__rail">
        <span class="ld-steps__line" aria-hidden="true"><i></i></span>
        {stations.map((station, index) => (
          <li class="ld-step" data-fx="rise">
            <span class="ld-step__num">{String(index + 1).padStart(2, "0")}</span>
            <p><strong style="color: var(--text); display: block; margin-bottom: 6px; font-family: var(--font-display);">{station.title}</strong>{station.copy}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- 4 · Vollbild-Welt: Kultur & Organisation -->
    <section class="lw-chapter">
      <div class="lw-chapter__stagebg" aria-hidden="true">
        <Pic src="/media/team.jpg" sizes="100vw" width="1600" height="1000" />
      </div>
      <span class="lw-vignette" aria-hidden="true"></span>
      <span class="lw-grain" aria-hidden="true"></span>
      <div class="lw-chapter__inner">
        <div class="lw-chapter__content" data-fx="rise">
          <span class="cine-label">Kultur & Organisation</span>
          <h2>Arbeit hinter der Kamera — und hinter dem Ablauf</h2>
          <p class="lw-chapter__lead">Ein gutes Ergebnis hängt nicht nur von Kameraeinstellungen ab. Kommunikation, Zeitplan, Zugänge, Technik und verlässliche Übergaben entscheiden genauso mit.</p>
          <p>Neben eigenen Produktionen arbeitet Sophia im Umfeld der Jungen Filmwerkstatt Düsseldorf. Dort verbindet sie Medienarbeit, Social Media und organisatorische Aufgaben — und war seit 2019 als Teilnehmerin und in der Organisation des 24-Stunden-Videowettbewerbs „24h to take" beteiligt.</p>
          <div class="lw-chapter__links">
            <a class="cine-link" href="/projekte/24h-to-take/"><span>Zum Projekt 24h to take</span><span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 5 · Gewerke-Welt: Was Sophia übernimmt, über der Set-Szene -->
    <section class="lw-chapter lw-chapter--roles">
      <div class="lw-chapter__stagebg" aria-hidden="true">
        <Pic src="/media/spektra-set-hoch.jpg" sizes="100vw" width="1600" height="1000" />
      </div>
      <span class="lw-dust" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span>
      <span class="lw-vignette" aria-hidden="true"></span>
      <span class="lw-grain" aria-hidden="true"></span>
      <div class="lw-chapter__inner">
        <div data-fx="rise">
          <span class="cine-label">Ein Set, eine Handschrift</span>
          <h2 class="cine-h2" style="margin-top: 10px; margin-bottom: clamp(20px, 3vh, 32px);">Was Sophia übernimmt</h2>
          <div class="sp-rolerows">
            <a class="sp-rolerow" href="/videografie/kamera-bildgestaltung/">
              <span class="sp-rolerow__name">Kamera</span>
              <span class="sp-rolerow__value">nah dran, ohne zu stören</span>
              <span class="sp-rolerow__go" aria-hidden="true">→</span>
            </a>
            <div class="sp-rolerow">
              <span class="sp-rolerow__name">Licht</span>
              <span class="sp-rolerow__value">Atmosphäre statt Ausleuchtung</span>
            </div>
            <a class="sp-rolerow" href="/videografie/tonaufnahme/">
              <span class="sp-rolerow__name">Ton</span>
              <span class="sp-rolerow__value">verständlich und räumlich</span>
              <span class="sp-rolerow__go" aria-hidden="true">→</span>
            </a>
            <a class="sp-rolerow" href="/postproduktion/">
              <span class="sp-rolerow__name">Schnitt</span>
              <span class="sp-rolerow__value">Rhythmus und Dramaturgie</span>
              <span class="sp-rolerow__go" aria-hidden="true">→</span>
            </a>
            <a class="sp-rolerow" href="/vj-mapping/live-visuals/">
              <span class="sp-rolerow__name">Live Visuals</span>
              <span class="sp-rolerow__value">Bilder, die live reagieren</span>
              <span class="sp-rolerow__go" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        <div class="sp-fits" data-fx="rise">
          <div class="sp-fits__group">
            <span class="u-meta">Besonders passend</span>
            <ul>
              <li>Musikvideos, Konzerte und Live-Sessions</li>
              <li>Festivals, Ausstellungen und Kulturveranstaltungen</li>
              <li>Persönliche Imagefilme und Porträts</li>
              <li>Live Visuals und Projection Mapping</li>
            </ul>
          </div>
          <div class="sp-fits__group">
            <span class="u-meta">Auch als Teil eines Teams</span>
            <ul>
              <li>Kamera und Bildgestaltung</li>
              <li>Ton in überschaubaren Setups</li>
              <li>Schnitt und Postproduktion</li>
              <li>Technische und visuelle Vorbereitung</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 6 · CTA: das Licht kehrt zurück -->
    <section class="ld-finale ld-finale--media">
      <div class="ld-finale__media" aria-hidden="true">
        <video muted loop playsinline preload="none" poster="/media/hero-poster.jpg" width="1280" height="720" data-finale-video>
          <source src="/media/hero-loop.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="ld-finale__portal" aria-hidden="true"></div>
      <div class="ld-finale__horizon" aria-hidden="true"></div>
      <div class="ld-finale__slit" aria-hidden="true"></div>
      <div class="cine-wrap ld-finale__content">
        <h2 class="ld-finale__title">Lernen wir uns kennen — am besten an einem <em>konkreten</em> Projekt.</h2>
        <p class="cine-lead">Ein paar Sätze zu Anlass, Ort und Zeitraum reichen. Das Formular ist direkt hier unten.</p>
        <a class="cine-btn finale__cta" href="#anfrage" data-magnetic>Zum Formular</a>
        <p class="u-meta" style="color: #8d86a0;">Düsseldorf · Antwort meist innerhalb von zwei Werktagen</p>
      </div>
    </section>

    <!-- 7 · Kontaktformular -->
    <section class="sp-kontakt" id="anfrage">
      <div class="cine-wrap contact-grid">
        <div data-fx="rise">
          <span class="cine-label">Direkter Kontakt</span>
          <h2 class="cine-h2">Kein langes Anfrageformular</h2>
          <div class="prose"><p>Wenn Termin oder Umfang noch offen sind, ist das kein Problem. Schreiben Sie, was bereits feststeht. Sophia meldet sich mit den nächsten sinnvollen Fragen zurück.</p></div>
          <address style="display: grid; gap: 10px; margin-top: 34px; font-style: normal;">
            <a href={`mailto:${site.email}`} style="color: var(--text); font-size: 1.15rem;">{site.email}</a>
            <a href={`tel:${site.phoneHref}`} style="color: var(--text); font-size: 1.15rem;">{site.phoneDisplay}</a>
            <span style="color: var(--text-muted);">Düsseldorf · Produktionen in NRW</span>
          </address>
        </div>
        <form class="contact-form" data-contact-form data-contact-email={site.email} data-fx="rise">
          <div class="form-field"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required maxlength="120" /></div>
          <div class="form-field"><label for="email">E-Mail</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="200" /></div>
          <div class="form-field"><label for="project">Worum geht es?</label><select id="project" name="project" required><option value="">Bitte auswählen</option><option>Videoproduktion</option><option>Kamera oder Ton</option><option>Postproduktion</option><option>VJ oder Projection Mapping</option><option>Etwas anderes</option></select></div>
          <div class="form-field form-field--full"><label for="message">Kurze Projektbeschreibung</label><textarea id="message" name="message" rows="7" required minlength="20" maxlength="5000" placeholder="Anlass, Ort, Zeitraum und gewünschtes Ergebnis"></textarea></div>
          <p class="form-note">Beim Absenden öffnet sich Ihr E-Mail-Programm mit den eingetragenen Angaben. Die Website speichert oder überträgt die Formulardaten nicht.</p>
          <button class="cine-btn" type="submit">E-Mail vorbereiten</button><p class="form-status" data-form-status aria-live="polite"></p>
        </form>
      </div>
    </section>
  </div>

  <script>
    import "../scripts/landing-motion.ts";
    import "../scripts/sophia-motion.ts";
  </script>
</BaseLayout>
