---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import FaqList from "./FaqList.astro";
import "../styles/landing.css";
import "../styles/service.css";
import { locations, projects, servicePath, type Location, type Service } from "../data/site";
import { localDetail } from "../data/local";

// Leistungs-Landingpage — und in der lokalisierten Variante die Stadtseite
// derselben Leistung (gleiche Struktur, eigener lokaler Kontext).
// Jede Seite öffnet mit der Themenwelt ihres Gewerks (gleiche Bildsprache
// wie die Kapitel des Leistungs-Hubs) und endet im Abspann-Finale.
const { service, parentLabel, parentHref, location } = Astro.props as {
  service: Service;
  parentLabel: string;
  parentHref: string;
  location?: Location;
};

const related = projects.filter((project) => service.relatedProjects.includes(project.slug));
const basePath = servicePath(service);
const localPath = (city: Location) => `${basePath}${city.slug}/`;

// Kapitelnummer wie im Leistungs-Hub — sie wandert mit auf die Landingpage.
const chapterOrder = [
  "eventfilm",
  "musikvideo",
  "imagefilm",
  "kamera-bildgestaltung",
  "tonaufnahme",
  "postproduktion",
  "live-visuals",
  "projection-mapping",
];
const heroNum = String(chapterOrder.indexOf(service.slug) + 1).padStart(2, "0");

// Bühnen-Motive je Gewerk (gleiche Motiv-Bausteine wie die Hub-Welten)
const heroFx: Record<string, string[]> = {
  eventfilm: ["beam", "dust"],
  musikvideo: ["bars"],
  imagefilm: ["glow", "dust"],
  "kamera-bildgestaltung": ["finder"],
  tonaufnahme: ["rings", "dust"],
  postproduktion: ["perf", "dust"],
  "live-visuals": ["echo", "scanlines"],
  "projection-mapping": ["grid", "scan"],
};
const fx = heroFx[service.slug] ?? ["dust"];

// Haltungszeile: **…** markiert den Akzentteil
const claimParts = service.claim.split("**");

// Von Hand geschriebene Stadt-Texte; ohne Eintrag greifen die Templates.
const local = location ? localDetail(location.slug, service.slug) : undefined;

const title = location
  ? (local?.seoTitle ?? `${service.title} in ${location.city} | Videografin Sophia Ramahi`)
  : service.seoTitle;
const description = location
  ? (local?.seoDescription ?? `${service.title} in ${location.city}: ${service.summary} Produktion aus Düsseldorf, Anfahrt transparent geplant.`)
  : service.seoDescription;

// Lokalseiten mit eigenen Texten führen die Stadt-Fragen zuerst und
// übernehmen nur die wichtigsten Leistungs-Fragen — die vollständige
// Liste bleibt der Hauptseite vorbehalten.
const faqs = location
  ? (local ? [...local.faq, ...service.faq.slice(0, 3)] : [...location.faq, ...service.faq])
  : service.faq;

const crumbs = location
  ? [{ label: "Start", href: "/" }, { label: parentLabel, href: parentHref }, { label: service.title, href: basePath }, { label: location.city }]
  : [{ label: "Start", href: "/" }, { label: parentLabel, href: parentHref }, { label: service.title }];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: location ? `${service.title} in ${location.city}` : service.title,
    description,
    provider: { "@id": "https://sophiaramahi.de/#business" },
    areaServed: location
      ? { "@type": "City", name: location.city }
      : { "@type": "AdministrativeArea", name: "Nordrhein-Westfalen" },
    url: `https://sophiaramahi.de${location ? localPath(location) : basePath}`,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];

const introParagraphs = location
  ? (local?.intro ?? [location.localAngle, location.logistics, service.outcome])
  : [service.intro, service.outcome];

const otherCities = location ? locations.filter((item) => item.slug !== location.slug).slice(0, 8) : [];
---

<BaseLayout title={title} description={description} image={service.image} schema={schema}>
  <div data-service>
    <!-- Hero: die Themenwelt des Gewerks -->
    <section class:list={["sd-hero", `sd-hero--${service.slug}`]}>
      <div class="lw-chapter__stagebg" aria-hidden="true">
        <img src={service.image} alt="" width="1600" height="1000" loading="eager" fetchpriority="high" decoding="async" />
        {fx.includes("echo") && (
          <img class="lw-echo" src={service.image} alt="" width="1600" height="1000" loading="eager" decoding="async" />
        )}
      </div>
      {fx.includes("beam") && <div class="lw-beam" aria-hidden="true"></div>}
      {fx.includes("glow") && <div class="lw-glow" aria-hidden="true"></div>}
      {fx.includes("bars") && (
        <span class="lw-bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
      )}
      {fx.includes("rings") && <span class="lw-rings" aria-hidden="true"><i></i><i></i><i></i></span>}
      {fx.includes("finder") && (
        <span class="lw-finder" aria-hidden="true"><i></i><i></i><i></i><i></i><span class="lw-finder__rec">Rec</span><span class="lw-finder__cross"></span></span>
      )}
      {fx.includes("perf") && (
        <>
          <span class="lw-perf lw-perf--l" aria-hidden="true"></span>
          <span class="lw-perf lw-perf--r" aria-hidden="true"></span>
        </>
      )}
      {fx.includes("grid") && <span class="lw-grid-overlay" aria-hidden="true"></span>}
      {fx.includes("scan") && <span class="lw-scan" aria-hidden="true"></span>}
      {fx.includes("scanlines") && <span class="lw-scanlines" aria-hidden="true"></span>}
      {fx.includes("dust") && (
        <span class="lw-dust" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span>
      )}
      <span class="lw-vignette" aria-hidden="true"></span>
      <span class="lw-grain" aria-hidden="true"></span>
      <span class="lw-chapter__ghost" aria-hidden="true">{heroNum}</span>
      <div class="cine-wrap sd-hero__content">
        <Breadcrumbs items={crumbs} />
        <p class="sd-hero__kicker">{heroNum} · {service.eyebrow}</p>
        <h1 class="sd-hero__title">
          {location ? (
            <>
              {service.title} <em>in {location.city}</em>
            </>
          ) : (
            service.title
          )}
        </h1>
        <p class="sd-hero__lead">{local?.lead ?? service.summary}</p>
        <div class="sd-hero__actions">
          <a class="cine-btn" href="/kontakt/">Projekt anfragen</a>
          {location ? (
            <a class="cine-ghost" href={`/standorte/${location.slug}/`}>Standort {location.city}</a>
          ) : (
            <a class="cine-ghost" href="/arbeiten/">Projekte ansehen</a>
          )}
        </div>
        <p class="sd-hero__meta">
          {location ? (
            <>
              <span>{location.region}</span>
              <span>{location.distance} von Düsseldorf</span>
              <span>Basis: Düsseldorf</span>
            </>
          ) : (
            <>
              <span>Düsseldorf & NRW</span>
              <span>Einzeln buchbar oder als Produktion</span>
            </>
          )}
        </p>
      </div>
      <span class="sd-hero__scroll" aria-hidden="true">Scrollen</span>
    </section>

    <!-- Haltungszeile -->
    <section class="sd-statement">
      <div class="cine-wrap">
        <span class="cine-label" data-fx="rise">{location ? `Vor Ort in ${location.city}` : "Der Ansatz"}</span>
        <p class="sd-claim" data-fx="rise">
          {claimParts.map((part, index) => (index % 2 === 1 ? <em>{part}</em> : part))}
        </p>
        <div class="sd-statement__prose">
          {introParagraphs.map((paragraph) => (
            <p data-fx="rise">{paragraph}</p>
          ))}
        </div>
      </div>
    </section>

    <!-- Leistungsumfang -->
    <section class="sd-scope">
      <div class="cine-wrap sd-scope__grid">
        <header class="sd-scope__head" data-fx="rise">
          <span class="cine-label">Leistungsumfang</span>
          <h2 class="cine-h2">{service.scopeTitle}</h2>
        </header>
        <div class="sd-scope__body">
          <ol class="sd-scope__list">
            {service.deliverables.map((item, index) => (
              <li class="sd-scope__row" data-fx="rise">
                <span class="sd-scope__num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <span class="sd-scope__item">{item}</span>
              </li>
            ))}
          </ol>
          <div class="sd-scope__fit" data-fx="rise">
            <span class="cine-label">Geeignet für</span>
            <ul class="sd-chips">
              {service.suitableFor.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Vor Ort: konkrete Orte und Bedingungen der Stadt (nur Lokalseiten) -->
    {local && location && (
      <section class="sd-focus sd-local">
        <span class="sd-focus__ghost" aria-hidden="true">{location.city}</span>
        <div class="cine-wrap">
          <div class="sd-head" data-fx="rise">
            <span class="cine-label">Drehorte & Anlässe</span>
            <h2 class="cine-h2">{local.placesTitle}</h2>
          </div>
          <ol class="sd-focus__items">
            {local.places.map((item, index) => (
              <li class="sd-focus__item" data-fx="rise">
                <span class="sd-focus__num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.copy}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    <!-- Vertiefung: die individuelle Facette des Gewerks -->
    <section class:list={["sd-focus", `sd-focus--${service.slug}`]}>
      <span class="sd-focus__ghost" aria-hidden="true">{service.focus.label}</span>
      <div class="cine-wrap">
        <div class="sd-head" data-fx="rise">
          <span class="cine-label">{service.focus.label}</span>
          <h2 class="cine-h2">{service.focus.title}</h2>
          <p class="cine-lead">{service.focus.lead}</p>
        </div>
        <ol class="sd-focus__items">
          {service.focus.items.map((item, index) => (
            <li class="sd-focus__item" data-fx="rise">
              <span class="sd-focus__num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.copy}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Ablauf als Filmstreifen -->
    <section class="sd-process">
      <div class="cine-wrap">
        <div class="sd-head" data-fx="rise">
          <span class="cine-label">Ablauf</span>
          <h2 class="cine-h2">{location ? `${service.processTitle} — geplant ab Düsseldorf` : service.processTitle}</h2>
        </div>
        <div class="sd-strip">
          <span class="sd-strip__perf sd-strip__perf--t" aria-hidden="true"></span>
          <ol class="sd-strip__clips">
            {service.process.map((step, index) => (
              <li class="sd-clip">
                <span class="sd-clip__num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <p>{step}</p>
              </li>
            ))}
          </ol>
          <span class="sd-strip__perf sd-strip__perf--b" aria-hidden="true"></span>
          <span class="sd-strip__head" aria-hidden="true"></span>
        </div>
      </div>
    </section>

    <!-- Referenzprojekte auf dem Lichttisch -->
    {related.length > 0 && (
      <section class="sd-projects">
        <div class="cine-wrap">
          <div class="sd-projects__head" data-fx="rise">
            <div>
              <span class="cine-label">{location ? "Referenzarbeiten aus Düsseldorf" : "Ausgewählte Arbeiten"}</span>
              <h2 class="cine-h2">Projekte, in denen das zusammenkam</h2>
            </div>
            <a class="cine-link" href="/arbeiten/"><span>Alle Projekte</span><span aria-hidden="true">→</span></a>
          </div>
          <div class:list={["sd-tiles", { "sd-tiles--solo": related.length === 1 }]}>
            {related.map((project) => (
              <a class:list={["sd-tile", { "sd-tile--electric": project.slug === "electric-lights" }]} href={`/projekte/${project.slug}/`}>
                <img src={project.image} alt={project.alt} width="1200" height="750" loading="lazy" decoding="async" />
                <span class="sd-tile__dim" aria-hidden="true"></span>
                <span class="sd-tile__meta">
                  <span class="cine-label">{project.category}{project.year ? ` · ${project.year}` : ""}</span>
                  <span class="sd-tile__title">{project.title}</span>
                  <span class="sd-tile__go">Projekt ansehen <span aria-hidden="true">→</span></span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- FAQ -->
    <section class="cine-wrap sd-faq">
      <div class="sd-head" data-fx="rise">
        <span class="cine-label">Kurz geklärt</span>
        <h2 class="cine-h2">{location ? `Häufige Fragen zu ${location.city}` : service.faqTitle}</h2>
      </div>
      <div data-fx="rise"><FaqList items={faqs} /></div>
    </section>

    <!-- Einsatzorte -->
    <section class="ld-places">
      <div class="cine-wrap">
        {location ? (
          <>
            <div class="ld-places__head" data-fx="rise">
              <span class="cine-label">Auch in der Region</span>
              <h2 class="cine-h2">{service.title} in weiteren Städten</h2>
            </div>
            <p class="ld-places__list" data-fx="rise">
              {otherCities.map((city) => (
                <a href={localPath(city)}>{city.city}</a>
              ))}
            </p>
            <div class="ld-places__note">
              <p class="u-caption">Alle Produktionen werden von Düsseldorf aus geplant — keine Niederlassungen, Anfahrt transparent im Angebot.</p>
              <a class="cine-link" href={basePath}><span>{service.title} im Überblick</span><span aria-hidden="true">→</span></a>
            </div>
          </>
        ) : (
          <>
            <div class="ld-places__head" data-fx="rise">
              <span class="cine-label">Einsatzorte</span>
              <h2 class="cine-h2">{service.title} in Düsseldorf und ganz NRW</h2>
              <p class="cine-lead">Die Basis ist Düsseldorf — produziert wird dort, wo das Projekt stattfindet.</p>
            </div>
            <p class="ld-places__list" data-fx="rise">
              {locations.map((city) => (
                <a href={localPath(city)}>{city.city}</a>
              ))}
            </p>
            <div class="ld-places__note">
              <p class="u-caption">Jede Stadtseite beschreibt, was vor Ort wichtig wird — Zugang, Logistik und Planung ab Düsseldorf.</p>
              <a class="cine-link" href="/standorte/"><span>Alle Einsatzorte</span><span aria-hidden="true">→</span></a>
            </div>
          </>
        )}
      </div>
    </section>

    <!-- Finale: Abspann über bewegtem Licht -->
    <section class="ld-finale ld-finale--media sd-finale">
      <div class="ld-finale__media" aria-hidden="true">
        <video muted loop playsinline preload="none" poster="/media/hero-poster.jpg" width="1280" height="720" data-finale-video>
          <source src="/media/hero-loop.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="ld-finale__portal" aria-hidden="true"></div>
      <div class="ld-finale__horizon" aria-hidden="true"></div>
      <div class="ld-finale__slit" aria-hidden="true"></div>
      <div class="cine-wrap ld-finale__content">
        <ol class="sd-credits" aria-label="Abspann">
          <li class="sd-credit"><span class="sd-credit__role">Projekt</span><i></i><span class="sd-credit__value">Ihres</span></li>
          <li class="sd-credit"><span class="sd-credit__role">Produktion</span><i></i><span class="sd-credit__value">Sophia Ramahi</span></li>
          {location ? (
            <li class="sd-credit"><span class="sd-credit__role">Drehort</span><i></i><span class="sd-credit__value">{location.city}{location.distance === "0 km" ? " · Basis" : ` · ${location.distance}`}</span></li>
          ) : (
            <li class="sd-credit"><span class="sd-credit__role">Basis</span><i></i><span class="sd-credit__value">Düsseldorf & NRW</span></li>
          )}
        </ol>
        <h2 class="ld-finale__title">{location ? `${service.title} in ${location.city} anfragen` : `${service.title} anfragen`}</h2>
        <p class="cine-lead">Schreiben Sie kurz, worum es geht, wo produziert werden soll und welcher Zeitraum realistisch ist.</p>
        <a class="cine-btn finale__cta" href="/kontakt/" data-magnetic>Projekt besprechen</a>
        <p class="sd-finale__note">Düsseldorf · Antwort meist innerhalb von zwei Werktagen</p>
      </div>
    </section>
  </div>

  <script>
    import "../scripts/service-motion.ts";
  </script>
</BaseLayout>
