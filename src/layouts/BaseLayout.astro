---
import "@fontsource-variable/archivo";
import "@fontsource-variable/instrument-sans";
import "../styles/site.css";
import "../styles/production.css";
import "../styles/performance.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site, services, servicePath } from "../data/site";

type SchemaNode = Record<string, unknown>;
type Props = {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  schema?: SchemaNode | SchemaNode[];
  article?: boolean;
  publishedAt?: string;
  modifiedAt?: string;
  preloadImage?: string;
  pageType?: "WebPage" | "ContactPage";
};

const {
  title,
  description,
  image = "/media/electric-lights-cover.jpg",
  imageAlt = title,
  noindex = false,
  schema,
  article = false,
  publishedAt,
  modifiedAt = publishedAt,
  preloadImage,
  pageType = "WebPage",
} = Astro.props as Props;

const canonical = new URL(Astro.url.pathname, site.url);
const imageUrl = new URL(image, site.url);
const pathname = Astro.url.pathname;
const customSchema = (schema ? (Array.isArray(schema) ? schema : [schema]) : []).map(
  ({ "@context": _context, ...node }) => node,
);
const graph = [
  {
    "@type": "WebSite",
    "@id": `${site.url}/#website`,
    url: site.url,
    name: site.name,
    inLanguage: "de-DE",
    publisher: { "@id": `${site.url}/#person` },
  },
  {
    "@type": "Person",
    "@id": `${site.url}/#person`,
    name: site.name,
    url: site.url,
    image: `${site.url}/media/sophia-portrait.jpg`,
    email: `mailto:${site.email}`,
    telephone: site.phoneHref,
    jobTitle: "Videografin und Mediengestalterin Bild und Ton",
    knowsAbout: services.map((service) => service.title),
    address: {
      "@type": "PostalAddress",
      streetAddress: site.address[0],
      postalCode: "40229",
      addressLocality: "Düsseldorf",
      addressCountry: "DE",
    },
    sameAs: site.social.map((item) => item.href),
  },
  {
    "@type": "ProfessionalService",
    "@id": `${site.url}/#business`,
    name: "Sophia Ramahi Videografie",
    url: site.url,
    image: `${site.url}/media/sophia-portrait.jpg`,
    email: `mailto:${site.email}`,
    telephone: site.phoneHref,
    founder: { "@id": `${site.url}/#person` },
    address: {
      "@type": "PostalAddress",
      streetAddress: site.address[0],
      postalCode: "40229",
      addressLocality: "Düsseldorf",
      addressCountry: "DE",
    },
    areaServed: { "@type": "AdministrativeArea", name: "Nordrhein-Westfalen" },
    priceRange: "Auf Anfrage",
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Leistungen",
      itemListElement: services.map((service) => ({
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: service.title,
          url: new URL(servicePath(service), site.url).toString(),
        },
      })),
    },
  },
  {
    "@type": pageType,
    "@id": `${canonical}#webpage`,
    url: canonical.toString(),
    name: title,
    description,
    inLanguage: "de-DE",
    isPartOf: { "@id": `${site.url}/#website` },
    about: { "@id": `${site.url}/#business` },
    primaryImageOfPage: {
      "@type": "ImageObject",
      contentUrl: imageUrl.toString(),
      caption: imageAlt,
    },
  },
  ...customSchema,
];
const allSchema = { "@context": "https://schema.org", "@graph": graph };
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#05030a" />
    <meta name="color-scheme" content="dark" />
    <meta name="author" content={site.name} />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="alternate" type="application/rss+xml" title="Sophia Ramahi Journal" href="/rss.xml" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {article && publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {article && modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}
    {article && <meta property="article:author" content={site.name} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(allSchema)} is:inline></script>
    <!-- Vor dem ersten Paint: Motion-Gate. Ohne JS oder mit reduzierter
         Bewegung bleibt jede Szene im offenen, vollständig lesbaren Zustand. -->
    <script is:inline>
      try {
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.classList.add("motion");
        }
      } catch (error) {
        /* Ohne matchMedia bleibt die Seite statisch. */
      }
    </script>
  </head>
  <body class="cine">
    <SiteHeader pathname={pathname} />
    <main id="inhalt"><slot /></main>
    <SiteFooter />
    <script>
      import "../scripts/site.ts";
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
