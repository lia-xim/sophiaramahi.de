# Kontaktformular-Versand über Resend (https://resend.com).
# Lokal: Datei als .env kopieren und Werte eintragen.
# Produktion: dieselben Variablen in Vercel unter Settings → Environment Variables setzen.

# API-Key aus dem Resend-Dashboard (beginnt mit re_). Ohne Key antwortet
# /api/kontakt mit 503 und die Seite verweist auf die direkte E-Mail.
RESEND_API_KEY=

# Empfängerin der Anfragen. Solange die Domain in Resend nicht verifiziert
# ist, erlaubt Resend nur die E-Mail-Adresse des eigenen Resend-Kontos.
CONTACT_TO=info@sophiaramahi.de

# Absender. Vor der Domain-Verifizierung muss der Resend-Testabsender
# genutzt werden; danach z. B. "Sophia Ramahi <anfrage@sophiaramahi.de>".
CONTACT_FROM=Sophia Ramahi Website <onboarding@resend.dev>
